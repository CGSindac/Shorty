<html>
    <body>
        <h1 class="header">LINK SHORTENER</h1>
        <main>
            <slot />
        </main>
    </body>
</html>

<style is:global>
    body {
        font-family: Cambria, Cochin, Georgia, Times, "Times New Roman", serif;

        margin: 0;
        padding: 0;

        width: 100vw;
        height: 100vh;

        overflow: hidden;
    }

    header {
        display: flex;
        justify-content: center;
        align-items: center;

        background-color: #a87e62;

        min-height: 70px;
    }

    main {
        width: 100%;
        height: 100%;

        background-color: #a87e62;
    }

    .header{
        position: absolute;
        top: 20px;
        left: 50%;
        transform: translate(-50%);
        z-index: 1;
        color: #311f13;
        font-size: 4rem;
    }

    button:hover {
        box-shadow: 1px 2px 3px #2a26229d;
        border: 2px thin #b07154;
    }

    button {
        border: none;
        border-radius: 4px;

        cursor: pointer;
        padding: 10px;

        background-color: #f4decb;
        color: #311f13;
        font-weight: bold;

        transition: all 0.3s ease;
    }

    .view{
        height: 100%;
        width: 100%;

        display: flex;
      
        justify-content: center;
        align-items: center;
        flex-direction: column;
    }
</style>
