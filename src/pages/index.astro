---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<!-- Component Below -->
<BaseLayout>
  <div>
  <input type="text" id="link">
  <button id="new-bttn">SHORTEN</button>
  <p id="bob"></p>
  </div>
</BaseLayout>
<style>
   div{

    display: flex;
    gap: 7px;
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  input[type="text"]{
    width: 40%;
    min-width: 400px;

    padding: 10px;
    font-size: 16;

    background-color: #f4decb;

    border-radius: 4px;
    border: 0px solid #b07154;

    transition: all 0.3s ease;
  } 
  input[type="text"]:hover{
    outline: none;
    box-shadow: 1px 2px 3px #2a26229d;
    border: 2px thin #b07154;
  }

  input[type="text"]:focus{
    outline: none;
    border: 2px solid #b07154;
  }

  button:hover{
    box-shadow: 1px 2px 3px #2a26229d;
    border: 2px thin #b07154;
  }

  button{
    border: none;
    border-radius: 4px;

    cursor: pointer;
    padding: 10px;

    background-color: #f4decb;
    color: 	#311f13;
    font-weight: bold;

    transition: all 0.3s ease;
  }
</style>
<script>
  const newBttn = document.getElementById("new-bttn");
  const entry = document.getElementById("link");
  const sign = document.getElementById("bob");
  newBttn?.addEventListener("click", async () => {
      // @ts-ignore
      const link = entry.value;

      try {
          const req = await fetch('https://shorters.calixgabriel093.workers.dev/api/link',
          {
            mode: 'cors',
            method: 'POST',
            headers:{
              "Content-Type" : "application/json"
            },
            body: JSON.stringify({
              url: link
            })
          }
        )

        const data = await req.json();
        
        // @ts-ignore
        if (data.status == 'ERROR')
          throw new Error("Invalid URL");
          
        sign!.innerHTML = data.data.url;
      } catch (err)
      {
        console.log(err);
        // @ts-ignore
        if (sign) { sign!.innerHTML = err; }
      }

  });
</script>

